# Copy to .env.local for local work, and add the same keys in Vercel > Settings > Environment Variables.
# Every value is optional: anything left empty shows a clear placeholder on the site.

# Production URL of the site (used for sitemap, canonical and social previews)
NEXT_PUBLIC_SITE_URL=

# WhatsApp number, digits only with country code, no "+" (e.g. 2348012345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact details shown across the site
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS=

# Text Google Maps should search for (usually the full business address)
NEXT_PUBLIC_MAP_QUERY=

# Quote form endpoint, e.g. https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_FORM_ENDPOINT=

# Social profiles (full URLs). Leave blank to hide a link.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
